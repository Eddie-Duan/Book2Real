# ── 服务 ────────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8790
DATA_DIR=./data
LOG_LEVEL=INFO
API_TOKEN=
CORS_ORIGINS=*

# ── ASR（本地 faster-whisper / 已有 9881 服务 / mock）────────────────────
ASR_PROVIDER=local
ASR_MODEL=large-v3
ASR_DEVICE=cuda
ASR_COMPUTE=float16
ASR_LANGUAGE=
ASR_HTTP_URL=http://127.0.0.1:9881/asr
ASR_PRELOAD=true
# 0=关闭滚动部分识别；350=每 350ms 用最近 4s 音频做一次快速识别
# 注意：本地 large-v3 上部分识别会与最终识别争用 GPU，建议压测后再开。
ASR_PARTIAL_MS=0
ASR_PARTIAL_WINDOW_S=4.0

# ── TTS（sapi 本地零延迟 / local 本地流式 9890 / MiniMax / mock / none）──
# 本地联调建议 sapi：Windows 自带中英音色，短句 10-80ms，先保证 2s 首音；
# 需要更好音质时切 local（CosyVoice3，首块约 2.5s）或拿到 API 后切 minimax。
TTS_PROVIDER=sapi
SAPI_VOICE_ZH=Huihui
SAPI_VOICE_EN=Zira
SAPI_RATE=0
TTS_LOCAL_URL=http://127.0.0.1:9890
TTS_LOCAL_BATCH_URL=http://127.0.0.1:9886/tts
TTS_LOCAL_REF_AUDIO=./data/voice_refs/default.wav
TTS_LOCAL_PROMPT_TEXT=这是一段用于音色克隆的参考音频转写。
TTS_LOCAL_SPEED=1.0
TTS_SAMPLE_RATE=24000
TTS_TIMEOUT_S=90
TTS_MAX_CLAUSE_CHARS=48

# MiniMax（拿到 key 后填这里；TTS / STT 可分别切换）
MINIMAX_HOST=https://api.minimaxi.com
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_TTS_MODEL=speech-2.8-turbo
# 推荐中文：Chinese (Mandarin)_Warm_Girl / female-shaonv / lovely_girl
MINIMAX_VOICE_ID=
# 推荐英文：Sweet_Girl / English_Graceful_Lady
MINIMAX_VOICE_ID_EN=
MINIMAX_SAMPLE_RATE=24000
MINIMAX_LANGUAGE_BOOST=auto
MINIMAX_SPEED=0.95
MINIMAX_VOL=1.0
MINIMAX_PITCH=0
# happy/sad/angry/fearful/disgusted/surprised/calm/fluent/whisper
# fluent/whisper 仅 speech-2.6；2.8 不支持 whisper
MINIMAX_EMOTION=calm
MINIMAX_ASR_MODEL=asr-1.0
# zh/yue/en/ja/ko/...；留空自动识别（支持中英混说）
MINIMAX_ASR_LANGUAGE=

# ── LLM（OpenAI 兼容 / 提取式兜底 / mock）──────────────────────────────
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.minimaxi.com/v1
LLM_API_KEY=
LLM_MODEL=MiniMax-M2.7-highspeed
LLM_TIMEOUT_S=20
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.3
LLM_TRANSLATE_TIMEOUT_S=2.0

# ── 语音回合 / 2s 延迟 ─────────────────────────────────────────────────
VAD_FRAME_MS=20
VAD_SILENCE_MS=500
VAD_MIN_SPEECH_MS=100
VAD_ENERGY_RATIO=3.2
VAD_MIN_RMS=0.006
FILLER_ENABLED=true
FILLER_DEADLINE_MS=1700
FILLER_ZH=嗯，我看看。
FILLER_EN=Hmm, let me see.
LATENCY_BUDGET_MS=2000
WARMUP_ON_START=true

# ── 绘本入库 / OCR ─────────────────────────────────────────────────────
OCR_DPI=150
OCR_MIN_TEXT_CHARS=40
OCR_USE_RAPIDOCR=true
# 文字层可用时也跑 OCR 补漏（画面里的印章/气泡对白），脚本“查找”要能命中
OCR_SUPPLEMENT=true
OCR_LANGS=ch,en
VIDEO_SAMPLE_FPS=1.0
VIDEO_MAX_FRAMES=900

# ── 数据 / 隐私 ────────────────────────────────────────────────────────
STORE_AUDIO=false
SESSION_HISTORY_TURNS=8
MODERATION_ENABLED=true
# true=绘本问答用检索原文秒回（推荐，MiniMax LLM thinking 慢）；false=全部走 LLM
FAST_ANSWER=true
