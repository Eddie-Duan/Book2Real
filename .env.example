# 复制成 .env 后填值；.env 已被 .gitignore 忽略，不会提交
# 说明见 docs/API_KEYS.md

# ============================================================
# 官方赛题指定的三件套（2026.11.30 开通，额度 ≤500 元、并发 ≤20）
# ============================================================
# ---- DeepSeek：故事 / 问答 / 判断 ----
# key 获取：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- 火山方舟 Ark：豆包文生图 Seedream + Seedance 文生视频 ----
# 一个 ARK key 同时开通图片与视频；key 获取：
# https://console.volcengine.com/ark/region:cn-beijing/apiKey
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 若组委会发的是接入点 id（ep-xxxx），直接把 id 填进下面两行
SEEDREAM_MODEL=doubao-seedream-3-0-t2i-250415
SEEDANCE_MODEL=doubao-seedance-1-0-lite-t2v-250428

# ---- 花费护栏（按官方 500 元额度留余量） ----
CLOUD_MAX_SPEND_CNY=50
SEEDREAM_CNY_PER_IMAGE=0.20
SEEDANCE_CNY_PER_SEC=1.00
DEEPSEEK_CNY_PER_1K_TOKENS=0.002

# ============================================================
# 旧实验后端（Recraft 修图 / 本地 2.5D），不是官方要求，可留空
# ============================================================
RECRAFT_API_TOKEN=
RECRAFT_API_BASE=https://external.api.recraft.ai
RECRAFT_MODEL=recraftv3
RECRAFT_OUTPUT_FORMAT=png
RECRAFT_MAX_SPEND_USD=2.00

# 下面三组是旧代码的通用别名；cloud.load_env() 会自动读 .env
VIDEO_API_PROVIDER=
VIDEO_API_BASE_URL=
VIDEO_API_KEY=
VIDEO_API_MODEL=

VLM_API_PROVIDER=
VLM_API_BASE_URL=
VLM_API_KEY=
VLM_API_MODEL=

LLM_API_PROVIDER=
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_API_MODEL=

# ============================================================
# 后端（backend/，原 paperbook-backend）——融合后的唯一后端服务
# 说明见 docs/BACKEND_MERGE.md；默认端口 8790
# ============================================================
APP_HOST=0.0.0.0
APP_PORT=8790
# 运行时数据（页图/索引/SQLite/缓存），默认仓库根目录 data/
# DATA_DIR=
LOG_LEVEL=INFO
API_TOKEN=
CORS_ORIGINS=*

# ASR：local（faster-whisper）/ http（已有 9881）/ mock（无语音环境冒烟）
ASR_PROVIDER=local
ASR_MODEL=large-v3
ASR_DEVICE=cuda
ASR_COMPUTE=float16
ASR_LANGUAGE=
ASR_HTTP_URL=http://127.0.0.1:9881/asr
ASR_PRELOAD=true
ASR_PARTIAL_MS=0
ASR_PARTIAL_WINDOW_S=4.0

# TTS：sapi（Windows 本地，10-80ms）/ local（CosyVoice3 9890）/ minimax / none
TTS_PROVIDER=sapi
SAPI_VOICE_ZH=Huihui
SAPI_VOICE_EN=Zira
SAPI_RATE=0
TTS_LOCAL_URL=http://127.0.0.1:9890
TTS_LOCAL_BATCH_URL=http://127.0.0.1:9886/tts
TTS_LOCAL_REF_AUDIO=
TTS_LOCAL_PROMPT_TEXT=
TTS_LOCAL_SPEED=1.0
TTS_SAMPLE_RATE=24000
TTS_TIMEOUT_S=90
TTS_MAX_CLAUSE_CHARS=48

# MiniMax（拿到官方 API 后填这里即可切换 TTS_PROVIDER=minimax）
MINIMAX_HOST=https://api.minimaxi.com
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_TTS_MODEL=speech-2.6-turbo
MINIMAX_VOICE_ID=
MINIMAX_SAMPLE_RATE=24000
MINIMAX_LANGUAGE_BOOST=auto

# LLM：留空则用上面的 DEEPSEEK_API_KEY / LLM_API_*；有 key 时自动切 openai 兼容
# LLM_PROVIDER=
# LLM_API_KEY=
# LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_S=20
LLM_MAX_TOKENS=120
LLM_TEMPERATURE=0.3
LLM_TRANSLATE_TIMEOUT_S=2.0

# 语音回合 / 2s 首音
VAD_FRAME_MS=20
VAD_SILENCE_MS=500
VAD_MIN_SPEECH_MS=100
VAD_ENERGY_RATIO=3.2
VAD_MIN_RMS=0.006
FILLER_ENABLED=true
FILLER_DEADLINE_MS=1400
FILLER_ZH=嗯，我看看。
FILLER_EN=Hmm, let me see.
LATENCY_BUDGET_MS=2000
WARMUP_ON_START=true

# 入库 / OCR / 视频
OCR_DPI=150
OCR_MIN_TEXT_CHARS=40
OCR_USE_RAPIDOCR=true
OCR_LANGS=ch,en
VIDEO_SAMPLE_FPS=1.0
VIDEO_MAX_FRAMES=900

# 数据 / 隐私
STORE_AUDIO=false
SESSION_HISTORY_TURNS=8
MODERATION_ENABLED=true
