# 复制成 .env 后填值；.env 已被 .gitignore 忽略，不会提交
# 说明见 docs/API_KEYS.md

# ---- 图像：Recraft（当前启用） ----
# token 获取：https://www.recraft.ai/app/api/api-keys
RECRAFT_API_TOKEN=
RECRAFT_API_BASE=https://external.api.recraft.ai
RECRAFT_MODEL=recraftv4_1
RECRAFT_OUTPUT_FORMAT=png
RECRAFT_MAX_SPEND_USD=2.00

# ---- 视频：暂不启用 ----
VIDEO_API_PROVIDER=
VIDEO_API_BASE_URL=
VIDEO_API_KEY=
VIDEO_API_MODEL=

